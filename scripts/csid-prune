#!/usr/bin/env bash
# Delete raw captures that have been verifiably shipped and have aged past the
# grace window.
#
# What is deleted: `capture.raw` and `ble_scan.jsonl` — the two durable
# intermediates. Their derived, self-describing forms (`capture.csiq`,
# `ble_rssi.parquet`) are already in object storage by the time this runs.
# What is kept forever: `metadata.json` and `.synced` — together they form a
# greppable on-node index of every session the node ever ran.
set -euo pipefail

SPOOL="${CSID_SPOOL:-/var/lib/csid}"
GRACE_DAYS="${CSID_PRUNE_GRACE_DAYS:-7}"

[[ -d "$SPOOL" ]] || { echo "csid-prune: spool $SPOOL missing" >&2; exit 0; }

freed=0
pruned=0
for dir in "$SPOOL"/*/; do
    [[ -d "$dir" ]] || continue
    marker="$dir/.synced"

    # Never prune what was never confirmed shipped.
    [[ -f "$marker" ]] || continue

    # Marker older than the grace window?
    if [[ -z "$(find "$marker" -mtime "+${GRACE_DAYS}" -print -quit 2>/dev/null)" ]]; then
        continue
    fi

    for name in capture.raw ble_scan.jsonl; do
        intermediate="$dir/$name"
        [[ -f "$intermediate" ]] || continue
        size=$(wc -c < "$intermediate" 2>/dev/null || echo 0)
        rm -f "$intermediate"
        freed=$((freed + size))
        pruned=$((pruned + 1))
        echo "csid-prune: removed $(basename "$dir")/$name"
    done
done

echo "csid-prune: pruned $pruned intermediate(s), freed $((freed / 1024 / 1024)) MiB"
