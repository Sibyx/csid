#!/usr/bin/env bash
# Delete raw captures that have been verifiably shipped and have aged past the
# grace window.
#
# What is deleted: `capture.raw` and `ble_scan.jsonl` — the two durable
# intermediates. Their derived, self-describing forms (`capture.csiq`,
# `ble_rssi.parquet`) are already in object storage by the time this runs.
# What is kept forever: `metadata.json` and `.synced` — together they form a
# greppable on-node index of every session the node ever ran.
set -euo pipefail

SPOOL="${CSID_SPOOL:-/var/lib/csid}"
GRACE_DAYS="${CSID_PRUNE_GRACE_DAYS:-7}"

# Grace is compared in MINUTES, not days.
#
# `find -mtime +N` truncates a file's age to whole 24 h units before comparing,
# so `-mtime +1` matches only files aged >= 48 h — i.e. a "1 day" grace was
# silently two days, and "0" was silently one. That off-by-a-day did not matter
# at the historical 7-day setting, but it does the moment the knob is used to
# bound disk on a segmented long run, where segments ship within ~15 min of
# sealing and the whole point is to reclaim promptly.
#
# `-mmin +N` truncates to whole minutes instead, so the error is one minute
# rather than one day and every value means what it says.
if ! [[ "$GRACE_DAYS" =~ ^[0-9]+$ ]]; then
    echo "csid-prune: CSID_PRUNE_GRACE_DAYS must be a non-negative integer (got '$GRACE_DAYS')" >&2
    exit 2
fi
GRACE_MINUTES=$(( GRACE_DAYS * 1440 ))

[[ -d "$SPOOL" ]] || { echo "csid-prune: spool $SPOOL missing" >&2; exit 0; }

freed=0
pruned=0
for dir in "$SPOOL"/*/; do
    [[ -d "$dir" ]] || continue
    marker="$dir/.synced"

    # Never prune what was never confirmed shipped.
    [[ -f "$marker" ]] || continue

    # Marker older than the grace window?
    if [[ -z "$(find "$marker" -mmin "+${GRACE_MINUTES}" -print -quit 2>/dev/null)" ]]; then
        continue
    fi

    for name in capture.raw ble_scan.jsonl; do
        intermediate="$dir/$name"
        [[ -f "$intermediate" ]] || continue
        size=$(wc -c < "$intermediate" 2>/dev/null || echo 0)
        rm -f "$intermediate"
        freed=$((freed + size))
        pruned=$((pruned + 1))
        echo "csid-prune: removed $(basename "$dir")/$name"
    done
done

echo "csid-prune: pruned $pruned intermediate(s), freed $((freed / 1024 / 1024)) MiB"
