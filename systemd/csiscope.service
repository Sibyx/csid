[Unit]
Description=csiscope — live CSI console for csid
Documentation=https://github.com/Sibyx/csid
After=network-online.target
Wants=network-online.target

# A crash-looping console must never hammer the node. StartLimit* are [Unit]
# directives — systemd ignores them (with a warning) under [Service].
#
# The budget is deliberately generous. What this guards against is a genuine
# crash loop; what it must NOT punish is a slow boot. On monad01 (2026-07-27)
# tailscaled took longer to bring up tailscale0 than the old five-attempt
# budget allowed, csiscope spent all five against an address that did not exist
# yet, and the console then sat in a `failed` state for ten hours — a state
# nothing clears automatically, because tripping the start limit is sticky
# until `systemctl reset-failed`. The in-process bind retry removes that
# particular race; this widens the budget for the next one.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=exec
# Arguments come from the environment file so config management can change the
# bind address or read-only mode without rewriting the unit.
EnvironmentFile=-/etc/csid/csiscope.env
ExecStart=/usr/local/bin/csiscope $CSISCOPE_ARGS
Restart=on-failure
RestartSec=5s

# NOTE: the boot race against tailscaled is handled inside csiscope, which
# retries a bind that fails with EADDRNOTAVAIL for up to three minutes (see
# `bind_when_available` in server.rs). It is deliberately not handled here:
# systemd's FreeBind= applies to .socket units only, and there is no
# equivalent for a Type=exec service — an `IPFreeBind=yes` line here is
# silently ignored with "Unknown key name", which is exactly the failure this
# comment exists to stop the next person rediscovering.

# csiscope is a strict consumer of the live stream: it binds the datagram
# socket, never touches the radio, and holds nothing the daemon needs. If it
# dies mid-experiment the capture is unaffected — that is the point of csid's
# best-effort live path.
RuntimeDirectory=csid
RuntimeDirectoryPreserve=yes

# Nice it below the capture path so the console can never compete with the
# RX thread for CPU.
Nice=10
CPUSchedulingPolicy=other

NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/etc/csid /run/csid /var/lib/csid

StandardOutput=journal
StandardError=journal
SyslogIdentifier=csiscope

[Install]
WantedBy=multi-user.target
